ENV=dev
# Never commit real secrets. In prod they come from Vault / a cloud secret manager.
DATABASE_URL=postgres://greenops_api:dev-only@localhost:5432/greenops?sslmode=disable
REDIS_ADDR=localhost:6379
# Auth0 (required when ENV != dev). The access token needs the namespaced claims email and email_verified
# (an Auth0 Action sets them); tenant and role are NOT read from the token.
AUTH0_DOMAIN=
# Development stand reachable from outside: DEV_BASIC_AUTH="user:password" with DEV_LOGIN_PAGE=true shows the
# product sign-in page instead of the browser prompt (only together with DEV_AUTH=true and APP_ENV=dev)
DEV_BASIC_AUTH=
DEV_LOGIN_PAGE=
AUTH0_AUDIENCE=
# Name of the Auth0 database connection used by password recovery (default Username-Password-Authentication)
AUTH0_DB_CONNECTION=
AUTH_CLAIM_NS=https://reliabilix.com/
ELECTRICITYMAPS_API_KEY=
# Optional region=ZONE overrides, e.g. eu-central-1=DE,eu-north-1=SE
ELECTRICITYMAPS_ZONE_OVERRIDES=
# Notifications (ADR-0019). The key seals destination addresses and webhook URLs at rest: openssl rand -base64 32
# (required outside ENV=dev to create destinations; losing it makes stored destinations unreadable)
NOTIFICATIONS_SECRET_KEY=
# Address of the web app, used for links in notifications (https, no path)
PUBLIC_BASE_URL=
# E-mail channel (optional; without SMTP_HOST e-mail is unavailable, in dev it is only logged)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# AWS account customers trust in their role policy (the platform's own identity needs sts:AssumeRole on customer roles)
PLATFORM_AWS_ACCOUNT_ID=
# GCP connector (optional): project where BigQuery jobs run, and the service account customers share their billing dataset with
PLATFORM_GCP_PROJECT=
PLATFORM_GCP_SERVICE_ACCOUNT=
PLATFORM_AZURE_CLIENT_ID=
PLATFORM_AZURE_CLIENT_SECRET=
# Object storage (required when ENV != dev; dev falls back to a local directory)
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_PATH_STYLE=
S3_ACCESS_KEY=
S3_SECRET_KEY=
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
CORS_ORIGINS=http://localhost:3000
# Release (docs/release/versioning.md): image names and tags are <REGISTRY>/<service>:<VERSION>; production pins exact tags.
REGISTRY=reliabilix
VERSION=0.1.0-alpha.68
COMMIT=dev
