ENV=dev
# Never commit real secrets. In prod they come from Vault / a cloud secret manager.
DATABASE_URL=postgres://greenops_api:dev-only@localhost:5432/greenops?sslmode=disable
REDIS_ADDR=localhost:6379
# Auth0 (required when ENV != dev). The access token needs the namespaced claims email and email_verified
# (an Auth0 Action sets them); tenant and role are NOT read from the token.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH_CLAIM_NS=https://reliabilix.com/
ELECTRICITYMAPS_API_KEY=
# AWS account customers trust in their role policy (the platform's own identity needs sts:AssumeRole on customer roles)
PLATFORM_AWS_ACCOUNT_ID=
# Object storage (required when ENV != dev; dev falls back to a local directory)
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=us-east-1
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
CORS_ORIGINS=http://localhost:3000
