# --- Auth0 (production) ---
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=            # openssl rand -hex 32
AUTH0_AUDIENCE=https://api.reliabilix.green
APP_BASE_URL=http://localhost:3000
AUTH_CLAIM_NS=https://reliabilix.com/
# --- Backend (server-side only; the browser never sees tokens) ---
API_URL=http://localhost:8080
# --- Local development without Auth0 (honoured only together with APP_ENV=dev) ---
APP_ENV=dev
DEV_AUTH=true
DEV_TENANT_ID=00000000-0000-4000-8000-000000000001
DEV_ROLE=owner
NEXT_PUBLIC_BUILD_VERSION=dev
