[Unit]
Description=Reliabilix GreenOps scheduler
After=network-online.target reliabilix-worker.service

[Service]
Type=simple
EnvironmentFile=%h/.config/reliabilix/scheduler.env
WorkingDirectory=%h/reliabilix-stand
ExecStart=%h/reliabilix-stand/bin/scheduler
# The stand holds real connections (docs/setup/stand.md): synchronization is scheduled. To keep a demonstration stand
# with fictitious accounts from calling clouds, set SCHEDULER_SKIP=cloudaccounts:sync_all,cloudaccounts:rightsizing_all
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=default.target
