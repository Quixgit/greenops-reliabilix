# The Kubernetes energy agent: reads Kepler from Prometheus and pushes workload energy to Reliabilix (ADR-0030).
# Run it hourly as a CronJob (docs/setup/kubernetes.md). Build: docker build -f deploy/docker/Dockerfile.agent .
FROM alpine:3.20
ARG VERSION=dev
ARG COMMIT=unknown
LABEL org.opencontainers.image.title="reliabilix-agent" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${COMMIT}" \
      org.opencontainers.image.source="https://github.com/Quixgit/greenops-reliabilix"
RUN apk add --no-cache bash curl jq coreutils ca-certificates \
 && adduser -D -u 10001 agent
COPY scripts/kepler-push.sh /usr/local/bin/kepler-push.sh
RUN chmod 0755 /usr/local/bin/kepler-push.sh
USER 10001
ENTRYPOINT ["/usr/local/bin/kepler-push.sh"]
